# Servidor
PORT=3000

# Firebase Admin SDK (descargar service account JSON desde Firebase Console
# y pegar sus valores aquí, o usar GOOGLE_APPLICATION_CREDENTIALS apuntando al archivo)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# API-Football (RapidAPI)
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=

# Secreto compartido para proteger POST /internal/sync/run
# (usado por el workflow de GitHub Actions y por el botón de re-sync manual del admin)
SYNC_SECRET=
